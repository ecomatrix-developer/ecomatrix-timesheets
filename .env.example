# Copy this file to .env.local (local dev) and set the same values as
# Environment Variables in the Vercel dashboard for production.
# Never commit the real .env.local — it contains live secrets.

# --- Supabase ---
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The service_role key (NOT the anon/publishable key) — bypasses Row Level
# Security, so it must only ever be used server-side, never exposed to the
# browser. Used by src/lib/supabaseAdmin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Session auth ---
# A long random string used to sign the session JWT. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Outbound email (Gmail SMTP via nodemailer, src/lib/mailer.ts) ---
# EMAIL_USER is the Gmail address mail is sent FROM. EMAIL_PASSWORD must be
# a 16-character Gmail "App Password" (Google Account -> Security -> 2-Step
# Verification -> App passwords), NOT the account's normal login password —
# Gmail rejects SMTP logins with the real password once 2FA is enabled.
EMAIL_USER=your-sender@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# Recipients for the automated weekly backup / owner's snapshot reports,
# and the in-app Contact form (src/app/contact).
ADMIN_EMAIL=admin-recipient@example.com
OWNER_EMAIL=owner-recipient@example.com

# TEMPORARY local-dev-only escape hatch. Leave unset/false normally. Only
# set to "true" if local antivirus "mail shield" scanning (e.g. Avast)
# intercepts the SMTP TLS connection with its own untrusted certificate,
# causing "self-signed certificate in certificate chain" errors. Prefer
# disabling that antivirus feature instead if possible. NEVER set this to
# true in a real deployment (Vercel, etc.) — nothing intercepts traffic
# there, so it's both unnecessary and insecure to leave on.
# EMAIL_TLS_INSECURE=true
